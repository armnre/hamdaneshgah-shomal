{
  "name": "hamdaneshgah-server",
  "private": true,
  "type": "module",
  "description": "هم‌دانشگاهی — Fastify + PostgreSQL API server (also serves the built frontend)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "node scripts/gen-endpoints.mjs",
    "build": "node scripts/gen-endpoints.mjs && node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "dev": "npm run build && npm start",
    "migrate": "node scripts/migrate.mjs",
    "set-admin": "node scripts/set-admin.mjs",
    "typecheck": "node scripts/gen-endpoints.mjs && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:migrations": "npm i --no-save @electric-sql/pglite@0.5.10 && node db/test-migrations.mjs",
    "test:concurrency": "node db/test-concurrency.mjs",
    "import-voters": "node scripts/import-voters.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.14.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.3"
  }
}
