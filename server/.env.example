# ── Required ──────────────────────────────────────────────
DATABASE_URL=postgres://hamdaneshgah:CHANGE_ME@localhost:5432/hamdaneshgah
# 32+ random chars:  openssl rand -base64 48
SESSION_SECRET=
# Public address of the site, no trailing slash (used in login emails)
SITE_URL=https://example.ac.ir
# HMAC key for national-ID hashes (32+ random chars). Changing it invalidates imported voter lists.
ZITE_VOTER_PEPPER=
# Comma-separated emails allowed to claim the first Super Admin
ZITE_BOOTSTRAP_ADMIN_EMAILS=

# ── Email (SMTP preferred; Resend as fallback) ────────────
MAIL_FROM=هم‌دانشگاهی <no-reply@example.ac.ir>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# RESEND_API_KEY=

# ── Optional ──────────────────────────────────────────────
# PORT=3000            (Plesk/Passenger sets this itself)
# DATABASE_SSL=false   (true for managed/remote Postgres with TLS)
# DB_POOL_MAX=10
# WEB_DIST=../web/dist
# UPLOAD_DIR=storage/uploads
# MAX_UPLOAD_MB=10
# COOKIE_SECURE=true   (false ONLY for plain-HTTP testing)
# LOG_LEVEL=info
